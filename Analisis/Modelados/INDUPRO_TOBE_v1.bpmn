        <omgdc:Bounds height="70" width="140" x="1210" y="1092"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="36" width="130" x="1215" y="1102"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task 9B (manualTask) — Lane Planta -->
      
