<?xml version="1.0" encoding="UTF-8"?>
<definitions
   xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
   xmlns:signavio="http://www.signavio.com"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   exporter="Signavio Process Editor, http://www.signavio.com"
   exporterVersion="26.18.0"
   expressionLanguage="http://www.w3.org/TR/XPath"
   id="sid-indupro-asis-v2-definitions"
   targetNamespace="http://www.signavio.com"
   typeLanguage="http://www.w3.org/2001/XMLSchema"
   xml:lang="es-EC"
   xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd">

  <!--
    =====================================================================
    INDUPRO S.A. — Proceso de Gestión de Pedidos (AS-IS CORREGIDO v2)
    SAP Signavio Regional Challenge 2026
    Modelado BPMN 2.0 — Correcciones aplicadas según feedback del profesor
    Reunión de revisión: 14 de mayo de 2026
    =====================================================================

    CORRECCIONES APLICADAS:

    C1 — Task "Validar datos del pedido" → GATEWAY XOR "¿Datos correctos?"
         Razón: "esa actividad tiene que ser un Gateway porque tú validas o verificas"
         Rutas: SÍ 85% → Verificar crédito | NO 15% → Notificar error + End Event

    C2 — Después de Task "Verificar crédito" → GATEWAY XOR "¿Crédito aprobado?"
         Razón: "debería notificar un mensaje... un evento de mensaje en rojo"
         Rutas: SÍ 80% → Consultar stock | NO 20% → Notificar rechazo + End Event
         (Integración SAP real: SD ↔ FI-AR / Accounts Receivable)

    C4 — INTERMEDIATE TIMER EVENT antes de "Reprocesar lote"
         Razón: "Reprocesar lote... hay un evento de tiempo"
         Modela la espera de 15 min para reprogramación tras rechazo de calidad

    C5 — Todas las salidas de los XOR Gateways etiquetadas en AMBOS lados:
         GW_Datos: "Sí (85%)" / "No (15%)"
         GW_Credito: "Sí (80%)" / "No (20%)"
         GW_Stock: "Sí (65%)" / "No (35%)"
         GW_Calidad: "Aprueba (82%)" / "Rechaza (18%)"

    SIMULACIÓN (parámetros actualizados):
      Ventana: 480 min | Frecuencia: 4 pedidos/día
      Ciclo total (peor caso: fabricación + timer + reproceso): ~585 min
      Costo total por pedido: ~$107.91
    =====================================================================
  -->

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- COLABORACIÓN                                                    -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <collaboration id="sid-collab-indupro-asis-v2">
    <extensionElements>
      <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="INDUPRO-ASIS-v2"/>
    </extensionElements>
    <participant
       id="sid-pool-indupro-v2"
       name="INDUPRO S.A."
       processRef="sid-process-indupro-asis-v2">
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
    </participant>
  </collaboration>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- PROCESO PRINCIPAL                                               -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <process
     id="sid-process-indupro-asis-v2"
     isClosed="false"
     isExecutable="false"
     name="Proceso de Gestión de Pedidos — AS-IS Corregido v2"
     processType="None">

    <extensionElements/>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- SWIMLANES (7 roles)                                         -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <laneSet id="sid-laneset-asis-v2">

      <lane id="sid-lane-ventas-v2" name="Ejecutivo de Ventas">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-start-solicitud</flowNodeRef>
        <flowNodeRef>sid-task-1-recepcion</flowNodeRef>
        <!-- C1: Gateway reemplaza Task de validación -->
        <flowNodeRef>sid-gw-datos-correctos</flowNodeRef>
        <flowNodeRef>sid-task-notif-error</flowNodeRef>
        <flowNodeRef>sid-end-datos-incorrectos</flowNodeRef>
        <flowNodeRef>sid-gw-join-rutas</flowNodeRef>
        <flowNodeRef>sid-task-6a-confirmacion</flowNodeRef>
      </lane>

      <lane id="sid-lane-finanzas-v2" name="Analista de Finanzas">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-task-3-credito</flowNodeRef>
        <!-- C2: Gateway de decisión de crédito -->
        <flowNodeRef>sid-gw-credito-aprobado</flowNodeRef>
        <flowNodeRef>sid-task-notif-credito</flowNodeRef>
        <flowNodeRef>sid-end-credito-rechazado</flowNodeRef>
        <flowNodeRef>sid-task-13-factura</flowNodeRef>
        <flowNodeRef>sid-end-pedido</flowNodeRef>
      </lane>

      <lane id="sid-lane-inventarios-v2" name="Coordinador de Inventarios">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-task-4-stock</flowNodeRef>
        <flowNodeRef>sid-gw-stock</flowNodeRef>
      </lane>

      <lane id="sid-lane-planificacion-v2" name="Planificador de Producción">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-task-6b-planificacion</flowNodeRef>
      </lane>

      <lane id="sid-lane-planta-v2" name="Operario de Planta">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-task-7-fabricacion</flowNodeRef>
        <!-- C4: Timer Intermediate Event -->
        <flowNodeRef>sid-timer-reprogramacion</flowNodeRef>
        <flowNodeRef>sid-task-9b-reproceso</flowNodeRef>
      </lane>

      <lane id="sid-lane-calidad-v2" name="Inspector de Calidad">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-task-8-inspeccion</flowNodeRef>
        <flowNodeRef>sid-gw-calidad</flowNodeRef>
      </lane>

      <lane id="sid-lane-logistica-v2" name="Coordinador de Logística">
        <extensionElements>
          <signavio:signavioMetaData metaKey="bgcolor" metaValue=""/>
          <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
        </extensionElements>
        <flowNodeRef>sid-task-10-empaque</flowNodeRef>
        <flowNodeRef>sid-task-11-transportista</flowNodeRef>
        <flowNodeRef>sid-task-12-entrega</flowNodeRef>
      </lane>

    </laneSet>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- EVENTO DE INICIO — Message                                   -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <startEvent
       id="sid-start-solicitud"
       name="Solicitud de&#10;pedido recibida">
      <documentation>
        Tipo: Message Start Event.
        El cliente envía su solicitud por correo electrónico, llamada telefónica o portal web.
        [SIMULACIÓN] Frecuencia: 4 pedidos/día — ventana 480 min.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <outgoing>sf-start-task1</outgoing>
      <messageEventDefinition id="sid-msg-def-solicitud-v2"/>
    </startEvent>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 1 — Recepcionar solicitud del cliente                  -->
    <!-- Lane: Ejecutivo de Ventas                                    -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-1-recepcion"
       isForCompensation="false"
       name="Recepcionar solicitud&#10;del cliente"
       startQuantity="1">
      <documentation>
        Responsable: Ejecutivo de Ventas | Herramienta: Correo / Teléfono
        Duración AS-IS: 30 min | Costo: $6.00 | Tipo: User Task (VA)
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-start-task1</incoming>
      <outgoing>sf-task1-gwdatos</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- C1 — CORRECCIÓN: XOR Gateway "¿Datos del pedido correctos?" -->
    <!-- Reemplaza Task "Validar datos del pedido manualmente"        -->
    <!-- Feedback: "esa actividad tiene que ser un Gateway porque tú  -->
    <!-- validas o verificas, si tienes línea de crédito o no"        -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <exclusiveGateway
       id="sid-gw-datos-correctos"
       name="¿Datos del pedido&#10;correctos?"
       gatewayDirection="Diverging">
      <documentation>
        CORRECCIÓN C1 — feedback profesor (14 may 2026).
        La validación de datos implica una decisión binaria y se modela como XOR Gateway.
        [SIMULACIÓN] Duración: 45 min (verificación manual en Excel)
        Probabilidades:
          SÍ (datos correctos): 85%
          NO (datos incorrectos / incompletos): 15%
        Responsable: Ejecutivo de Ventas | Herramienta: Excel (sin integración con ERP)
        PROBLEMA AS-IS (P1): ingreso manual genera errores de transcripción.
        TO-BE: el portal SD de SAP valida en tiempo real (0 min, tasa de error ≈ 0).
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task1-gwdatos</incoming>
      <outgoing>sf-gwdatos-si-task3</outgoing>
      <outgoing>sf-gwdatos-no-notifer</outgoing>
    </exclusiveGateway>

    <!-- C1 — Rama NO: Notificar error al cliente -->
    <task
       completionQuantity="1"
       id="sid-task-notif-error"
       isForCompensation="false"
       name="Notificar error al cliente&#10;(datos incorrectos)"
       startQuantity="1">
      <documentation>
        Ruta: NO del GW_Datos (15% de los pedidos)
        Responsable: Ejecutivo de Ventas | Herramienta: Correo / Teléfono
        Duración AS-IS: 10 min | Costo: $2.00 | Tipo: User Task (NVA — error)
        Acción: Se contacta al cliente para que corrija/complete la información.
        En el AS-IS, esta comunicación es manual y sin trazabilidad.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffcccc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwdatos-no-notifer</incoming>
      <outgoing>sf-notifer-end-datos</outgoing>
    </task>

    <!-- C1 — Rama NO: End Event (pedido rechazado — datos incorrectos) -->
    <endEvent
       id="sid-end-datos-incorrectos"
       name="Pedido rechazado&#10;(datos incorrectos)">
      <documentation>
        Fin del proceso: el cliente no corrigió los datos del pedido.
        En el AS-IS, este fin se registra manualmente.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-notifer-end-datos</incoming>
    </endEvent>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 3 — Verificar crédito del cliente                      -->
    <!-- Lane: Analista de Finanzas                                   -->
    <!-- (se mantiene como Task, se agrega GW después — C2)          -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-3-credito"
       isForCompensation="false"
       name="Verificar crédito&#10;del cliente"
       startQuantity="1">
      <documentation>
        Responsable: Analista de Finanzas | Herramienta: Sistema Financiero Manual
        Duración AS-IS: 60 min | Costo: $13.00 | Tipo: User Task
        CUELLO DE BOTELLA #1: proceso bloqueado 6-8h si el analista no está disponible.
        Sin integración SD ↔ FI-AR. Verifica manualmente la línea de crédito del cliente.
        TO-BE: módulo SAP SD ↔ FI-AR verifica automáticamente en tiempo real (10 min).
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwdatos-si-task3</incoming>
      <outgoing>sf-task3-gwcredito</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- C2 — CORRECCIÓN: XOR Gateway "¿Crédito aprobado?"          -->
    <!-- Feedback: "debería notificar un mensaje… un evento de        -->
    <!-- mensaje en rojo [si se rechaza el crédito]"                  -->
    <!-- Integración SAP real: módulo SD ↔ FI-AR (Accounts Rec.)    -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <exclusiveGateway
       id="sid-gw-credito-aprobado"
       name="¿Crédito&#10;aprobado?"
       gatewayDirection="Diverging">
      <documentation>
        CORRECCIÓN C2 — feedback profesor (14 may 2026).
        La verificación de crédito tiene dos resultados excluyentes:
          - Cliente tiene línea de crédito suficiente → proceso continúa
          - Cliente supera límite / sin línea → notificación + fin del proceso
        [SIMULACIÓN] Duración: 5 min (decisión posterior a verificación manual)
        Probabilidades:
          SÍ (crédito aprobado): 80%
          NO (crédito rechazado — supera línea): 20%
        Integración SAP real: SD consulta FI-AR (línea de crédito, saldo pendiente).
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task3-gwcredito</incoming>
      <outgoing>sf-gwcredito-si-task4</outgoing>
      <outgoing>sf-gwcredito-no-notif</outgoing>
    </exclusiveGateway>

    <!-- C2 — Rama NO: Notificar rechazo de crédito -->
    <task
       completionQuantity="1"
       id="sid-task-notif-credito"
       isForCompensation="false"
       name="Notificar rechazo de&#10;crédito al cliente"
       startQuantity="1">
      <documentation>
        Ruta: NO del GW_Credito (20% de los pedidos)
        Responsable: Analista de Finanzas | Herramienta: Correo / Teléfono
        Duración AS-IS: 15 min | Costo: $3.25 | Tipo: User Task (NVA)
        Acción: Se informa al cliente el motivo del rechazo.
        El cliente puede: pagar por adelantado, reducir cantidad, o negociar línea de crédito.
        En el AS-IS, esta comunicación es manual y sin trazabilidad.
        TO-BE: FI-AR genera notificación automática con opciones de pago (Send Task / email).
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffcccc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwcredito-no-notif</incoming>
      <outgoing>sf-notif-credito-end</outgoing>
    </task>

    <!-- C2 — Rama NO: End Event (crédito rechazado) -->
    <endEvent
       id="sid-end-credito-rechazado"
       name="Pedido rechazado&#10;(crédito insuficiente)">
      <documentation>
        Fin del proceso: el crédito del cliente fue rechazado por el área de Finanzas.
        En el AS-IS se registra manualmente. En el TO-BE el módulo FI-AR bloquea
        automáticamente el pedido en SAP SD y genera el aviso al cliente.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-notif-credito-end</incoming>
    </endEvent>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 4 — Consultar disponibilidad de stock en bodega        -->
    <!-- Lane: Coordinador de Inventarios                            -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-4-stock"
       isForCompensation="false"
       name="Consultar disponibilidad&#10;de stock en bodega"
       startQuantity="1">
      <documentation>
        Responsable: Coordinador de Inventarios
        Herramienta: Registro físico en bodega + ERP legacy (fuentes no integradas)
        Duración AS-IS: 50 min | Costo: $8.33 | Tipo: User Task
        CUELLO DE BOTELLA #2: doble fuente de verdad con frecuentes discrepancias.
        TO-BE: consulta en tiempo real al módulo SAP MM (Inventory Management).
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwcredito-si-task4</incoming>
      <outgoing>sf-task4-gwstock</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- GATEWAY XOR-STOCK — ¿Hay stock disponible?                 -->
    <!-- C5: ambas salidas etiquetadas                               -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <exclusiveGateway
       id="sid-gw-stock"
       name="¿Hay stock&#10;disponible?"
       gatewayDirection="Diverging">
      <documentation>
        Tipo: Exclusive Gateway (XOR) — Divergente
        [SIMULACIÓN] SÍ (65%) / NO (35%)
        C5: ambas salidas etiquetadas explícitamente.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task4-gwstock</incoming>
      <outgoing>sf-gwstock-si-joinrutas</outgoing>
      <outgoing>sf-gwstock-no-task6b</outgoing>
    </exclusiveGateway>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 6B — Programar orden de producción                     -->
    <!-- Lane: Planificador de Producción                            -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-6b-planificacion"
       isForCompensation="false"
       name="Programar orden&#10;de producción"
       startQuantity="1">
      <documentation>
        Responsable: Planificador de Producción | Herramienta: Planilla manual
        Duración AS-IS: 40 min | Costo: $9.33 | Ruta: NO (35% de pedidos)
        PROBLEMA (P6): sin visibilidad de capacidad real (78% utilización oculta).
        TO-BE: módulo SAP PP-MRP + PP-CRP genera la orden automáticamente
        con fecha de entrega calculada según carga real de los centros de trabajo.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwstock-no-task6b</incoming>
      <outgoing>sf-task6b-task7</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 7 — Fabricar el producto                               -->
    <!-- Lane: Operario de Planta                                    -->
    <!-- RESTRICCIÓN TÉCNICA INAMOVIBLE: 120 min                    -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-7-fabricacion"
       isForCompensation="false"
       name="Fabricar el producto"
       startQuantity="1">
      <documentation>
        Responsable: Operarios de Planta (6 disponibles, turno 8h)
        Herramienta: Órdenes de trabajo impresas (sin digitalización)
        Duración AS-IS: 120 min — RESTRICCIÓN TÉCNICA INAMOVIBLE
        Costo: $16.00 | Ruta: 35% de pedidos
        QC solo al final → alta tasa de reproceso (18%).
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task6b-task7</incoming>
      <outgoing>sf-task7-task8</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 8 — Inspeccionar y liberar calidad del lote            -->
    <!-- Lane: Inspector de Calidad                                  -->
    <!-- RESTRICCIÓN REGULATORIA INAMOVIBLE: 30 min                 -->
    <!-- Recibe: flujo normal (Task7) + loop de reproceso (Task9B)  -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-8-inspeccion"
       isForCompensation="false"
       name="Inspeccionar y liberar&#10;calidad del lote"
       startQuantity="1">
      <documentation>
        Responsable: Inspector de Calidad (2 disponibles)
        Herramienta: Checklist físico impreso (sin digitalización)
        Duración AS-IS: 30 min — REQUISITO REGULATORIO INAMOVIBLE
        Costo: $5.50
        Recibe flujo de Task_7 (fabricación normal) Y de Task_9B (post-reproceso).
        QC reactivo: defectos detectados al final amplían el costo del pedido.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task7-task8</incoming>
      <incoming>sf-task9b-task8</incoming>
      <outgoing>sf-task8-gwcalidad</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- GATEWAY XOR-CALIDAD — ¿Pasa control de calidad?            -->
    <!-- C5: ambas salidas etiquetadas                               -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <exclusiveGateway
       id="sid-gw-calidad"
       name="¿Pasa control&#10;de calidad?"
       gatewayDirection="Diverging">
      <documentation>
        Tipo: Exclusive Gateway (XOR) — Divergente
        [SIMULACIÓN] APRUEBA (82%) / RECHAZA (18%)
        CUELLO DE BOTELLA #3: 18 de cada 100 lotes en fabricación → reproceso.
        Causa raíz: sin control de calidad en-proceso durante la fabricación.
        C5: ambas salidas etiquetadas explícitamente.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task8-gwcalidad</incoming>
      <outgoing>sf-gwcalidad-aprueba-joinrutas</outgoing>
      <outgoing>sf-gwcalidad-rechaza-timer</outgoing>
    </exclusiveGateway>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- C4 — CORRECCIÓN: Intermediate Timer Event                   -->
    <!-- Lane: Operario de Planta                                    -->
    <!-- Feedback: "Reprocesar lote... hay un evento de tiempo"      -->
    <!-- Modela la espera para reprogramación tras rechazo de QC     -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <intermediateCatchEvent
       id="sid-timer-reprogramacion"
       name="Espera reprogramación&#10;del lote (15 min)">
      <documentation>
        CORRECCIÓN C4 — feedback profesor (14 may 2026).
        Intermediate Timer Event: modela el tiempo de espera entre el rechazo de calidad
        y el inicio efectivo del reproceso. Incluye: coordinación con operarios,
        liberación del puesto de trabajo e instrucciones del supervisor.
        Duración: 15 min (distribución fija)
        TO-BE: el módulo QM de SAP emite instrucciones automáticas al operario
        en tiempo real, eliminando este tiempo de espera.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwcalidad-rechaza-timer</incoming>
      <outgoing>sf-timer-task9b</outgoing>
      <timerEventDefinition id="sid-timer-def-reproceso">
        <timeDuration xsi:type="tFormalExpression">PT15M</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 9B — Reprocesar lote rechazado                         -->
    <!-- Lane: Operario de Planta                                    -->
    <!-- ACTIVIDAD SIN VALOR AGREGADO (NVA) — pink                  -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-9b-reproceso"
       isForCompensation="false"
       name="Reprocesar lote&#10;rechazado"
       startQuantity="1">
      <documentation>
        Responsable: Operarios de Planta + Inspector de Calidad
        Herramienta: Manual (sin apoyo de sistema)
        Duración AS-IS: 90 min | Costo: $12.00
        Ruta: RECHAZA (18%) del GW_Calidad, precedida de Timer (15 min)
        Clasificación: SIN VALOR AGREGADO (NVA) — rework completo
        Flujo: tras reproceso, el lote vuelve a Task_8 (inspección) para nueva evaluación.
        Impacto total: 15 min espera + 90 min reproceso = 105 min adicionales al ciclo.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffcccc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-timer-task9b</incoming>
      <outgoing>sf-task9b-task8</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- GATEWAY XOR-JOIN — Convergencia de rutas (stock y calidad)  -->
    <!-- Lane: Ejecutivo de Ventas                                    -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <exclusiveGateway
       id="sid-gw-join-rutas"
       name=""
       gatewayDirection="Converging">
      <documentation>
        XOR Converging — une:
          1. Ruta directa: GW_Stock SÍ (65% de pedidos — hay stock)
          2. Ruta fabricación: GW_Calidad APRUEBA (82% × 35% de pedidos)
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-gwstock-si-joinrutas</incoming>
      <incoming>sf-gwcalidad-aprueba-joinrutas</incoming>
      <outgoing>sf-joinrutas-task6a</outgoing>
    </exclusiveGateway>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 6A — Confirmar pedido al cliente                       -->
    <!-- Lane: Ejecutivo de Ventas                                    -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-6a-confirmacion"
       isForCompensation="false"
       name="Confirmar pedido&#10;al cliente"
       startQuantity="1">
      <documentation>
        Responsable: Ejecutivo de Ventas | Herramienta: Correo electrónico
        Duración AS-IS: 20 min | Costo: $4.00 | Tipo: User Task
        PROBLEMA (P4): sin trazabilidad; el cliente puede esperar horas sin información.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-joinrutas-task6a</incoming>
      <outgoing>sf-task6a-task10</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 10 — Empacar y preparar para despacho                  -->
    <!-- Lane: Coordinador de Logística                              -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-10-empaque"
       isForCompensation="false"
       name="Empacar y preparar&#10;para despacho"
       startQuantity="1">
      <documentation>
        Responsable: Operarios de Logística | Herramienta: Manual
        Duración AS-IS: 25 min | Costo: $4.17 | Tipo: User Task (VA)
        Restricción logística: despacho solo entre 07:00 y 14:00.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task6a-task10</incoming>
      <outgoing>sf-task10-task11</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 11 — Asignar transportista y programar entrega         -->
    <!-- Lane: Coordinador de Logística                              -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-11-transportista"
       isForCompensation="false"
       name="Asignar transportista&#10;y programar entrega"
       startQuantity="1">
      <documentation>
        Responsable: Coordinador de Logística | Herramienta: Correo / Teléfono (sin TMS)
        Duración AS-IS: 30 min | Costo: $5.00 | Tipo: User Task
        PROBLEMA (P7): asignación por llamadas sin visibilidad de tracking.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task10-task11</incoming>
      <outgoing>sf-task11-task12</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 12 — Entregar al cliente y firmar conformidad          -->
    <!-- Lane: Coordinador de Logística                              -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-12-entrega"
       isForCompensation="false"
       name="Entregar al cliente&#10;y firmar conformidad"
       startQuantity="1">
      <documentation>
        Responsable: Transportista / Coordinador de Logística
        Herramienta: Guía de remisión impresa (papel)
        Duración AS-IS: 45 min (incluye traslado) | Costo: $7.50 | Tipo: User Task (VA)
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task11-task12</incoming>
      <outgoing>sf-task12-task13</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- TASK 13 — Generar y enviar factura al cliente               -->
    <!-- Lane: Analista de Finanzas                                   -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <task
       completionQuantity="1"
       id="sid-task-13-factura"
       isForCompensation="false"
       name="Generar y enviar&#10;factura al cliente"
       startQuantity="1">
      <documentation>
        Responsable: Analista de Finanzas
        Herramienta: Sistema de facturación (no integrado automáticamente)
        Duración AS-IS: 20 min | Costo: $4.33 | Tipo: User Task
        Activación manual tras confirmación de entrega. Sin generación automática.
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task12-task13</incoming>
      <outgoing>sf-task13-end</outgoing>
    </task>

    <!-- ─────────────────────────────────────────────────────────── -->
    <!-- EVENTO DE FIN PRINCIPAL — Pedido entregado y facturado      -->
    <!-- Lane: Analista de Finanzas                                   -->
    <!-- ─────────────────────────────────────────────────────────── -->
    <endEvent
       id="sid-end-pedido"
       name="Pedido entregado&#10;y facturado">
      <documentation>
        Fin del proceso principal.
        [RESULTADOS AS-IS CORREGIDO — Ruta peor caso]:
          Ciclo total (fabricación + timer + reproceso): ~585 min
          Costo total por pedido: ~$107.91
          Tiempo NVA: ~225 min (38.5% del ciclo)
          Tasa de reproceso: 18% de lotes fabricados
        3 posibles End Events en el proceso corregido:
          1. sid-end-datos-incorrectos (C1 — 15% de pedidos)
          2. sid-end-credito-rechazado (C2 — 20% de los que pasan C1)
          3. sid-end-pedido (proceso completo exitoso)
      </documentation>
      <extensionElements>
        <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
        <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
      </extensionElements>
      <incoming>sf-task13-end</incoming>
    </endEvent>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SEQUENCE FLOWS                                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Inicio → Task1 -->
    <sequenceFlow id="sf-start-task1" sourceRef="sid-start-solicitud" targetRef="sid-task-1-recepcion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task1 → GW_Datos -->
    <sequenceFlow id="sf-task1-gwdatos" sourceRef="sid-task-1-recepcion" targetRef="sid-gw-datos-correctos">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- C5: GW_Datos SÍ (85%) → Task3 -->
    <sequenceFlow id="sf-gwdatos-si-task3" name="Sí&#10;(datos correctos — 85%)"
       sourceRef="sid-gw-datos-correctos" targetRef="sid-task-3-credito">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">Datos del pedido completos y correctos (probabilidad: 85%)</conditionExpression>
    </sequenceFlow>

    <!-- C5: GW_Datos NO (15%) → Task_NotifError -->
    <sequenceFlow id="sf-gwdatos-no-notifer" name="No&#10;(datos incorrectos — 15%)"
       sourceRef="sid-gw-datos-correctos" targetRef="sid-task-notif-error">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">Datos del pedido incorrectos o incompletos (probabilidad: 15%)</conditionExpression>
    </sequenceFlow>

    <!-- Task_NotifError → End_DatosIncorrectos -->
    <sequenceFlow id="sf-notifer-end-datos" sourceRef="sid-task-notif-error" targetRef="sid-end-datos-incorrectos">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task3 → GW_Credito -->
    <sequenceFlow id="sf-task3-gwcredito" sourceRef="sid-task-3-credito" targetRef="sid-gw-credito-aprobado">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- C5: GW_Credito SÍ (80%) → Task4 -->
    <sequenceFlow id="sf-gwcredito-si-task4" name="Sí&#10;(crédito aprobado — 80%)"
       sourceRef="sid-gw-credito-aprobado" targetRef="sid-task-4-stock">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">El cliente tiene línea de crédito suficiente (probabilidad: 80%)</conditionExpression>
    </sequenceFlow>

    <!-- C5: GW_Credito NO (20%) → Task_NotifCredito -->
    <sequenceFlow id="sf-gwcredito-no-notif" name="No&#10;(crédito rechazado — 20%)"
       sourceRef="sid-gw-credito-aprobado" targetRef="sid-task-notif-credito">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">El cliente supera su línea de crédito disponible (probabilidad: 20%)</conditionExpression>
    </sequenceFlow>

    <!-- Task_NotifCredito → End_CreditoRechazado -->
    <sequenceFlow id="sf-notif-credito-end" sourceRef="sid-task-notif-credito" targetRef="sid-end-credito-rechazado">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task4 → GW_Stock -->
    <sequenceFlow id="sf-task4-gwstock" sourceRef="sid-task-4-stock" targetRef="sid-gw-stock">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- C5: GW_Stock SÍ (65%) → GW_JoinRutas -->
    <sequenceFlow id="sf-gwstock-si-joinrutas" name="Sí&#10;(hay stock — 65%)"
       sourceRef="sid-gw-stock" targetRef="sid-gw-join-rutas">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">Hay stock disponible en bodega (probabilidad: 65%)</conditionExpression>
    </sequenceFlow>

    <!-- C5: GW_Stock NO (35%) → Task6B -->
    <sequenceFlow id="sf-gwstock-no-task6b" name="No&#10;(sin stock — 35%)"
       sourceRef="sid-gw-stock" targetRef="sid-task-6b-planificacion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">No hay stock disponible; se debe fabricar (probabilidad: 35%)</conditionExpression>
    </sequenceFlow>

    <!-- Task6B → Task7 -->
    <sequenceFlow id="sf-task6b-task7" sourceRef="sid-task-6b-planificacion" targetRef="sid-task-7-fabricacion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task7 → Task8 -->
    <sequenceFlow id="sf-task7-task8" sourceRef="sid-task-7-fabricacion" targetRef="sid-task-8-inspeccion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task8 → GW_Calidad -->
    <sequenceFlow id="sf-task8-gwcalidad" sourceRef="sid-task-8-inspeccion" targetRef="sid-gw-calidad">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- C5: GW_Calidad APRUEBA (82%) → GW_JoinRutas -->
    <sequenceFlow id="sf-gwcalidad-aprueba-joinrutas" name="Aprueba&#10;(82%)"
       sourceRef="sid-gw-calidad" targetRef="sid-gw-join-rutas">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">El lote aprueba el control de calidad (probabilidad: 82%)</conditionExpression>
    </sequenceFlow>

    <!-- C4+C5: GW_Calidad RECHAZA (18%) → Timer_Repro -->
    <sequenceFlow id="sf-gwcalidad-rechaza-timer" name="Rechaza&#10;(18%)"
       sourceRef="sid-gw-calidad" targetRef="sid-timer-reprogramacion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
      <conditionExpression xsi:type="tFormalExpression">El lote no aprueba el control de calidad; requiere reproceso (probabilidad: 18%)</conditionExpression>
    </sequenceFlow>

    <!-- Timer → Task9B -->
    <sequenceFlow id="sf-timer-task9b" sourceRef="sid-timer-reprogramacion" targetRef="sid-task-9b-reproceso">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task9B → Task8 (loop: Planta → Calidad, vuelve a inspección) -->
    <sequenceFlow id="sf-task9b-task8" name="Vuelve a&#10;inspección"
       sourceRef="sid-task-9b-reproceso" targetRef="sid-task-8-inspeccion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- GW_JoinRutas → Task6A -->
    <sequenceFlow id="sf-joinrutas-task6a" sourceRef="sid-gw-join-rutas" targetRef="sid-task-6a-confirmacion">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task6A → Task10 (Ventas → Logística, cruce vertical de lanes) -->
    <sequenceFlow id="sf-task6a-task10" sourceRef="sid-task-6a-confirmacion" targetRef="sid-task-10-empaque">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task10 → Task11 -->
    <sequenceFlow id="sf-task10-task11" sourceRef="sid-task-10-empaque" targetRef="sid-task-11-transportista">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task11 → Task12 -->
    <sequenceFlow id="sf-task11-task12" sourceRef="sid-task-11-transportista" targetRef="sid-task-12-entrega">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task12 → Task13 (Logística → Finanzas, sube) -->
    <sequenceFlow id="sf-task12-task13" sourceRef="sid-task-12-entrega" targetRef="sid-task-13-factura">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

    <!-- Task13 → End -->
    <sequenceFlow id="sf-task13-end" sourceRef="sid-task-13-factura" targetRef="sid-end-pedido">
      <extensionElements><signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/></extensionElements>
    </sequenceFlow>

  </process>

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- BPMN DIAGRAM INTERCHANGE (DI) — Layout visual                  -->
  <!--                                                                 -->
  <!-- Canvas: 2660 × 1050 px (expandido +200px respecto AS-IS v1)   -->
  <!-- Pool: x=80, y=40, w=2660, h=1050                              -->
  <!-- Lanes: x=110, w=2630                                           -->
  <!--                                                                 -->
  <!-- Coordenadas de lanes (y desde arriba, h=145 c/u):              -->
  <!--   Ventas         y=40   center_y=112                            -->
  <!--   Finanzas       y=185  center_y=257                            -->
  <!--   Inventarios    y=330  center_y=402                            -->
  <!--   Planificación  y=475  center_y=547                            -->
  <!--   Planta         y=620  center_y=692                            -->
  <!--   Calidad        y=765  center_y=837                            -->
  <!--   Logística      y=910  center_y=982                            -->
  <!--                                                                 -->
  <!-- Elementos desplazados +200px respecto AS-IS v1:                -->
  <!--   Task4, GW_Stock, Task6B, Task7, Task8, GW_Calidad, Task9B,  -->
  <!--   GW_JoinRutas, Task6A, Task10, Task11, Task12, Task13, End    -->
  <!--                                                                 -->
  <!-- Elementos nuevos en esta versión:                               -->
  <!--   GW_Datos (490,112), Task_NotifError (640,112)                -->
  <!--   End_DatosIncorrectos (758,112)                                -->
  <!--   GW_Credito (780,257), Task_NotifCredito (910,257)            -->
  <!--   End_CreditoRechazado (1043,257)                               -->
  <!--   Timer_Repro (1700,692)                                        -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="sid-diagram-indupro-asis-v2">
    <bpmndi:BPMNPlane
       bpmnElement="sid-collab-indupro-asis-v2"
       id="sid-plane-indupro-asis-v2">

      <!-- Pool -->
      <bpmndi:BPMNShape bpmnElement="sid-pool-indupro-v2" id="sid-pool-indupro-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="1050" width="2660" x="80" y="40"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="140" width="24" x="80" y="470"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Lanes -->
      <bpmndi:BPMNShape bpmnElement="sid-lane-ventas-v2" id="sid-lane-ventas-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="40"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="68"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="sid-lane-finanzas-v2" id="sid-lane-finanzas-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="185"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="213"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="sid-lane-inventarios-v2" id="sid-lane-inventarios-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="330"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="358"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="sid-lane-planificacion-v2" id="sid-lane-planificacion-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="475"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="503"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="sid-lane-planta-v2" id="sid-lane-planta-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="620"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="648"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="sid-lane-calidad-v2" id="sid-lane-calidad-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="765"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="793"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="sid-lane-logistica-v2" id="sid-lane-logistica-v2_gui" isHorizontal="true">
        <omgdc:Bounds height="145" width="2630" x="110" y="910"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="96" width="12" x="116" y="938"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ──────────────────────────────────────────────── -->
      <!-- NODE SHAPES                                       -->
      <!-- ──────────────────────────────────────────────── -->

      <!-- Start Event — Ventas (center 200,112) -->
      <bpmndi:BPMNShape bpmnElement="sid-start-solicitud" id="sid-start-solicitud_gui">
        <omgdc:Bounds height="36" width="36" x="182" y="94"/>
        <bpmndi:BPMNLabel><omgdc:Bounds height="24" width="80" x="160" y="135"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Task1 — Ventas (center 320,112) -->
